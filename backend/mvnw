#!/bin/sh
# ----------------------------------------------------------------------------
# Maven Wrapper Script for Unix / macOS
# ----------------------------------------------------------------------------

set -e

# Prefer Homebrew OpenJDK 21/22 on macOS for Spring Boot compatibility
if [ -d "/opt/homebrew/opt/openjdk" ]; then
    export JAVA_HOME="/opt/homebrew/opt/openjdk"
    export PATH="$JAVA_HOME/bin:$PATH"
elif [ -d "/usr/local/opt/openjdk" ]; then
    export JAVA_HOME="/usr/local/opt/openjdk"
    export PATH="$JAVA_HOME/bin:$PATH"
fi

# Locate project base directory
PRG="$0"
while [ -h "$PRG" ]; do
    ls=$(ls -ld "$PRG")
    link=$(expr "$ls" : '.*-> \(.*\)$')
    if expr "$link" : '/.*' > /dev/null; then
        PRG="$link"
    else
        PRG="$(dirname "$PRG")/$link"
    fi
done
BASE_DIR="$(cd "$(dirname "$PRG")" && pwd)"

# Verify Java is available
if ! command -v java >/dev/null 2>&1; then
    echo "Error: JAVA_HOME is not set and no 'java' command could be found in your PATH." >&2
    echo "Please set JAVA_HOME or install Java (e.g. 'brew install openjdk')." >&2
    exit 1
fi

WRAPPER_PROP="$BASE_DIR/.mvn/wrapper/maven-wrapper.properties"
MAVEN_VERSION="3.9.9"

if [ -f "$WRAPPER_PROP" ]; then
    DIST_URL=$(grep 'distributionUrl' "$WRAPPER_PROP" | cut -d'=' -f2 | tr -d '\r')
fi

if [ -z "$DIST_URL" ]; then
    DIST_URL="https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/${MAVEN_VERSION}/apache-maven-${MAVEN_VERSION}-bin.zip"
fi

MAVEN_HOME="$HOME/.m2/wrapper/dists/apache-maven-${MAVEN_VERSION}"

if [ ! -d "$MAVEN_HOME" ]; then
    echo "Downloading Maven ${MAVEN_VERSION}..."
    TMP_ZIP="/tmp/apache-maven-${MAVEN_VERSION}.zip"
    mkdir -p "$MAVEN_HOME"
    if command -v curl >/dev/null 2>&1; then
        curl -sSL "$DIST_URL" -o "$TMP_ZIP"
    elif command -v wget >/dev/null 2>&1; then
        wget -qO "$TMP_ZIP" "$DIST_URL"
    else
        echo "Error: curl or wget is required to download Maven." >&2
        exit 1
    fi
    unzip -q -o "$TMP_ZIP" -d "/tmp/mvn_extract"
    mv /tmp/mvn_extract/apache-maven-*/* "$MAVEN_HOME/"
    rm -rf /tmp/mvn_extract "$TMP_ZIP"
    chmod +x "$MAVEN_HOME/bin/mvn"
fi

exec "$MAVEN_HOME/bin/mvn" "$@"
